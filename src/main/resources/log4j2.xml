<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_DIR">logs</Property>
        <Property name="ARCHIVE_LOG_DIR">${LOG_DIR}/archive</Property>

        <Property name="PATTERN_FILE">%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Property>
        <Property name="PATTERN_CONSOLE">%d{HH:mm:ss} %-5level - %msg%n</Property>
    </Properties>

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN_CONSOLE}"/>
        </Console>

        <RollingFile
                name="RollingFile"
                fileName="${LOG_DIR}/application.log"
                filePattern="${ARCHIVE_LOG_DIR}/application-%d{yyyy-MM-dd}-%i.log.gz"
                append="true">

            <PatternLayout pattern="${PATTERN_FILE}"/>

            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>

            <DefaultRolloverStrategy max="10"/>

        </RollingFile>

    </Appenders>

    <Loggers>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

    </Loggers>

</Configuration>

